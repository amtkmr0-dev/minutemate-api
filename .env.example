# ---- Server ----
NODE_ENV=development
PORT=3000

# Neon Postgres connection string (REQUIRED in production).
# Get one free at https://neon.tech — keep it secret, never commit it.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Long random string for signing JWTs (REQUIRED in production).
# Generate: openssl rand -base64 64
JWT_SECRET=

# Comma-separated list of allowed web origins, or "*" for dev.
ALLOWED_ORIGINS=*

# ---- Razorpay ----
# Public key id — safe to expose, returned to the client by /create-order.
RAZORPAY_KEY_ID=
# Secret key — SERVER ONLY. Never send to the client, never log it.
RAZORPAY_KEY_SECRET=

# ---- Payments mode ----
# "razorpay" (default) = real Razorpay orders.
# "simulation" = SIM_ orders + /simulate-success works, no real charges.
PAYMENTS_MODE=simulation
# In production, simulation additionally requires this to be "true".
PAYMENTS_SIMULATION_ENABLED=true
