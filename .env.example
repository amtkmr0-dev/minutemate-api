# ---- Server ----
NODE_ENV=development
PORT=3000

# Neon Postgres connection string (REQUIRED in production).
# Get one free at https://neon.tech — keep it secret, never commit it.
DATABASE_URL=

# Long random string for signing JWTs (REQUIRED in every environment).
# Generate: openssl rand -base64 64
JWT_SECRET=

# Comma-separated list of allowed web origins, or "*" for dev.
ALLOWED_ORIGINS=*

# ---- Razorpay ----
# Public key id — safe to expose, returned to the client by /create-order.
RAZORPAY_KEY_ID=
# Secret key — SERVER ONLY. Never send to the client, never log it.
RAZORPAY_KEY_SECRET=

# ---- Payments mode ----
# "razorpay" (default) = real Razorpay orders.
# Simulation requires BOTH switches plus NODE_ENV=development or test.
# Never point simulation at a database containing real wallets.
PAYMENTS_MODE=razorpay
PAYMENTS_SIMULATION_ENABLED=false
# Production refuses simulation even if the flag is true.

# ---- SMS (explicitly disabled by default) ----
# Set SMS_PROVIDER=twilio only for an authorized, provisioned SMS sender.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number. No provider calls occur in tests.
TWILIO_FROM_NUMBER=

# ---- Call media ----
ZEGO_APP_ID=
# Exactly 32 ASCII bytes; server only, never return or log it.
ZEGO_SERVER_SECRET=
# Optional wss:// endpoint; invalid schemes are refused, not rewritten.
# If absent, the existing AppID-derived Zego WebSocket endpoint is used.
ZEGO_SERVER_URL=

# Verification uses an in-memory PostgreSQL engine, not DATABASE_URL or .env.
# See docs/local-hardening.md before any server startup or live operation.
